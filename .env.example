# Local database and infrastructure credentials
MYSQL_DATABASE=help_hub
MYSQL_USER=help_hub
MYSQL_PASSWORD=help-hub-local
MYSQL_ROOT_PASSWORD=help-hub-root-local
REDIS_PASSWORD=help-hub-redis-local
RABBITMQ_USER=help_hub
RABBITMQ_PASSWORD=help-hub-rabbit-local
