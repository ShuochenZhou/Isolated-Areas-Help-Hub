page { background: #f6f1e7; color: #203b32; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif; overflow-wrap: break-word; }
.page { min-height: 100vh; padding: 28rpx 28rpx calc(56rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.hero { position: relative; overflow: hidden; padding: 40rpx; border-radius: 36rpx; color: #fff; background: linear-gradient(135deg, #174c40, #2d7b63); box-shadow: 0 18rpx 42rpx rgba(28,82,67,.18); }
.hero::after { content: ''; position: absolute; width: 260rpx; height: 260rpx; border-radius: 50%; right: -90rpx; top: -100rpx; background: rgba(255,255,255,.1); }
.eyebrow { font-size: 22rpx; letter-spacing: 4rpx; opacity: .72; }
.hero-title { display: block; margin-top: 12rpx; font-size: 48rpx; font-weight: 700; line-height: 1.25; }
.hero-copy { display: block; margin-top: 14rpx; max-width: 520rpx; font-size: 26rpx; line-height: 1.7; opacity: .82; }
.section-title { display: flex; justify-content: space-between; align-items: flex-end; margin: 38rpx 4rpx 20rpx; }
.section-title text:first-child { font-size: 34rpx; font-weight: 700; }
.section-title text:last-child { color: #7b8983; font-size: 24rpx; }
.card { margin-bottom: 20rpx; padding: 28rpx; border: 1rpx solid rgba(36,75,62,.08); border-radius: 28rpx; background: #fffdf8; box-shadow: 0 10rpx 30rpx rgba(48,68,60,.06); }
.row { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; }
.row > view, .row > text { min-width: 0; }
.muted { color: #7b8983; font-size: 24rpx; line-height: 1.6; }
.title { font-size: 30rpx; font-weight: 650; }
.row .title { word-break: break-word; }
.pill { display: inline-flex; padding: 7rpx 16rpx; border-radius: 999rpx; color: #246b58; background: #e4f1eb; font-size: 22rpx; }
.pill.orange { color: #9b4c2f; background: #fae6dc; }
/* A status label beside a title stays on one line ("Ready to collect"); the title wraps instead. */
.row > .pill { flex: none; white-space: nowrap; }
.btn { display: flex; align-items: center; justify-content: center; width: 100%; min-height: 88rpx; margin: 0; padding: 0 20rpx; box-sizing: border-box; border: 0; border-radius: 24rpx; color: #fff; background: #246b58; font-size: 29rpx; font-weight: 600; line-height: 1.35; }
.btn::after { border: 0; }
.btn.secondary { color: #246b58; background: #e4f1eb; }
.btn.warn { background: #c65c3f; }
.btn[disabled], button[disabled] { opacity: .56; }
.field { margin-bottom: 24rpx; }
.field-label { display: block; margin: 0 0 10rpx 4rpx; color: #53665f; font-size: 25rpx; }
.input, .textarea, .picker { width: 100%; box-sizing: border-box; padding: 23rpx 24rpx; border: 1rpx solid #dce3df; border-radius: 20rpx; background: #fff; font-size: 28rpx; }
/* <input> carries its own default height, so border-box vertical padding collapses
   its text box and clips the value. Give it an explicit height instead. */
.input { height: 88rpx; padding: 0 24rpx; }
.textarea { min-height: 170rpx; }
.empty { padding: 90rpx 30rpx; text-align: center; color: #819089; }
.state-card { margin: 22rpx 0; padding: 26rpx; border-radius: 24rpx; color: #5f7069; background: rgba(255,253,248,.9); font-size: 25rpx; line-height: 1.6; text-align: center; }
.state-card.error { color: #8b4c38; background: #fff0e8; }
.state-card text { display: block; }
.retry-btn { min-width: 180rpx; margin: 18rpx auto 0; padding: 0 24rpx; border: 0; border-radius: 18rpx; color: #fff; background: #246b58; font-size: 24rpx; line-height: 64rpx; }
.retry-btn::after { border: 0; }
.loading-dot { display: inline-block; width: 12rpx; height: 12rpx; margin-right: 10rpx; border-radius: 50%; background: #3d806c; animation: pulse 1.1s ease-in-out infinite; }
@keyframes pulse { 0%, 100% { opacity: .28; transform: scale(.75); } 50% { opacity: 1; transform: scale(1); } }
.status-line { margin-top: 16rpx; padding-top: 16rpx; border-top: 1rpx solid #edf0ed; }
.safe-bottom { height: env(safe-area-inset-bottom); }
.release-id { margin-top: 42rpx; color: #9aa59f; font-size: 20rpx; letter-spacing: 1rpx; text-align: center; }
