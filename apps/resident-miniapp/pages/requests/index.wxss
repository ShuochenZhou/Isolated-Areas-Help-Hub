.top { margin-top: 8rpx; }
.request-id { display: block; margin-bottom: 8rpx; color: #9a6b58; font-size: 21rpx; letter-spacing: 2rpx; }
.meta { display: flex; gap: 14rpx; margin: 22rpx 0; color: #6d7d76; font-size: 23rpx; }
.meta text { padding: 7rpx 13rpx; border-radius: 12rpx; background: #f0f2ee; }
/* Each tag stays whole; tags that do not fit move to the next line. */
.meta { flex-wrap: wrap; }
.meta text { white-space: nowrap; }
.timeline { display: flex; margin: 22rpx 0; }
.step { display: flex; align-items: center; flex: 1; }
.step-dot { width: 18rpx; height: 18rpx; border: 4rpx solid #d5ddd9; border-radius: 50%; background: #fff; }
.step-line { flex: 1; height: 4rpx; background: #d5ddd9; }
.step:last-child .step-line { display: none; }
.step.done .step-dot { border-color: #246b58; background: #246b58; }
.step.done .step-line { background: #246b58; }
.action { margin: 20rpx 0 0; height: 72rpx; line-height: 72rpx; border: 0; border-radius: 18rpx; color: #246b58; background: #e4f1eb; font-size: 25rpx; }
.action::after { border: 0; }
/* As on the home page: without the base library's vertical padding the label sits in the middle. */
.card .action { padding: 0 16rpx; }
.empty-line { display: block; margin-top: 8rpx; }
.decision { margin-top: 12rpx; padding: 16rpx 20rpx; border-radius: 16rpx; background: #eef6f2; color: #246b58; font-size: 24rpx; line-height: 36rpx; }
.decision.rejected { background: #fbefe9; color: #b0513a; }
.action-row { display: flex; }
.action-row .action { flex: 1; }
.action-row .action + .action { margin-left: 16rpx; }
.action.ghost { color: #b0513a; background: #fbefe9; }
/* Status labels stay on one line; a long request title wraps beside them instead. */
.status-pill { flex: none; white-space: nowrap; }
/* "Rated, thank you": a settled state, not a broken button. */
.action-row .action[disabled] { color: #73817b; background: #eef1ee; opacity: 1; }
