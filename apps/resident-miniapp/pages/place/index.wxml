<view class="picker-page">
  <view class="address-form">
    <text class="field-label">{{t.addressLabel}}</text>
    <view class="search-row">
      <input class="input search-input" maxlength="100" placeholder="{{t.addressPlaceholder}}" value="{{address}}"
             bindinput="bindAddress" confirm-type="search" bindconfirm="search" />
      <button class="search-btn" size="mini" type="primary" loading="{{searching}}" disabled="{{searching}}" bindtap="search">{{searching ? t.searching : t.search}}</button>
    </view>
    <text class="muted hint">{{t.addressHint}}</text>
    <view wx:if="{{notice}}" class="notice">{{notice}}</view>
    <view wx:if="{{results.length}}" class="results">
      <text class="results-title">{{t.resultsTitle}}</text>
      <scroll-view scroll-y class="results-list">
        <view wx:for="{{results}}" wx:key="index" class="result {{index === chosenIndex ? 'result-chosen' : ''}}" data-index="{{index}}" bindtap="choose">
          <text class="result-title">{{item.title}}</text>
          <text class="result-address">{{item.address}}</text>
        </view>
      </scroll-view>
    </view>
  </view>
  <view class="map-wrap">
    <map id="placePicker" class="picker-map" latitude="{{initialLatitude}}" longitude="{{initialLongitude}}"
         scale="16" enable-rotate="{{false}}" bindregionchange="regionChange" />
    <view class="crosshair"><view class="crosshair-head"></view><view class="crosshair-stem"></view></view>
    <view class="picker-tip">{{t.mapTip}}</view>
  </view>
  <view class="picker-form">
    <view class="row coord-row">
      <text class="title">{{located ? (adjusted ? t.adjusted : t.located) : t.notLocated}}</text>
      <text class="coords">{{located ? coordinates : ''}}</text>
    </view>
    <view wx:if="{{located && rangeText}}" class="muted range-text">{{rangeText}}</view>
    <view wx:if="{{located && tooFar}}" class="range-warning">{{t.tooFar}}</view>
    <view wx:if="{{outOfRange}}" class="range-warning">{{t.outOfRange}}</view>
    <button class="btn" disabled="{{outOfRange}}" bindtap="confirm">{{t.confirm}}</button>
  </view>
</view>
