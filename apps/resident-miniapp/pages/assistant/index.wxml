<view class="assistant-page">
  <view class="safety">{{t.safety}}</view>
  <view class="messages">
    <view wx:for="{{messages}}" wx:key="index" class="message {{item.role}}"><view class="bubble"><text>{{item.content}}</text><view wx:if="{{item.tools && item.tools.length}}" class="tool-note">{{item.providerText}} · {{item.toolsText}}</view></view></view>
    <view wx:if="{{sending}}" class="message assistant"><view class="bubble typing">{{t.working}}</view></view>
  </view>
  <view wx:if="{{messages.length === 1}}" class="quick-list"><text wx:for="{{quick}}" wx:key="*this" data-text="{{item}}" bindtap="quickAsk">{{item}}</text></view>
  <view class="composer"><input value="{{input}}" maxlength="2000" placeholder="{{t.placeholder}}" bindinput="bindInput" confirm-type="send" bindconfirm="send"/><button loading="{{sending}}" disabled="{{sending || !input}}" bindtap="send">{{t.send}}</button></view>
</view>
