{
  "name": "help-hub-resident-web",
  "private": true,
  "version": "1.1.9",
  "description": "Browser runtime and compiler for the Isolated Areas Help Hub resident WeChat application.",
  "type": "module",
  "scripts": {
    "sync": "node scripts/sync-miniapp.mjs",
    "verify": "node scripts/verify-miniapp.mjs",
    "manifest": "node scripts/write-miniapp-manifest.mjs",
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "build": "node scripts/verify-miniapp.mjs && vue-tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "node e2e/journey.mjs",
    "fidelity": "node e2e/fidelity.mjs",
    "bundle:vercel": "node scripts/bundle-vercel.mjs"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "qrcode-generator": "^1.4.4",
    "vue": "^3.5.21"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.20",
    "@types/node": "^24.3.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.1.0",
    "magic-string": "^0.30.17",
    "playwright-core": "^1.55.0",
    "postcss": "^8.5.6",
    "postcss-selector-parser": "^7.1.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.6"
  }
}
