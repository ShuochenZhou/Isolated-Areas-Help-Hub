# Copy to deploy/.env and replace every value. Never commit the real file.
MYSQL_PASSWORD=change-me-mysql
MYSQL_ROOT_PASSWORD=change-me-mysql-root
REDIS_PASSWORD=change-me-redis
RABBITMQ_PASSWORD=change-me-rabbitmq
# At least 32 characters each.
JWT_SECRET=change-me-to-a-long-random-jwt-secret-0000000000
PICKUP_CODE_SECRET=change-me-to-a-long-random-pickup-secret-000000

# Staff sign-in for the operations page (account must exist as an ADMIN user, see V12 migration).
OPERATOR_LOGIN_PHONE=
OPERATOR_LOGIN_PASSWORD=

# Optional services: the AI assistant model and typed-address search.
LLM_API_KEY=
TENCENT_MAP_KEY=
AMAP_KEY=

BACKEND_PORT=8082
WEB_PORT=8088
